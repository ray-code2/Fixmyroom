PORT=8080
FMR_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081
FMR_DATASOURCE_URL=jdbc:h2:file:./data/fmr-phase1;MODE=PostgreSQL
FMR_DATASOURCE_USERNAME=sa
FMR_DATASOURCE_PASSWORD=
FMR_LOG_FILE=logs/fmr-api.log

# Local dev only: activates application-dev.yml, which supplies a non-production
# JWT secret fallback so local runs work without setting one by hand. Do NOT set
# this outside local dev — staging/production must set FMR_JWT_SECRET directly;
# the app refuses to start without it when the dev profile isn't active.
SPRING_PROFILES_ACTIVE=dev
# FMR_JWT_SECRET=set-a-real-random-secret-of-at-least-32-bytes-here   # required outside the dev profile
FMR_JWT_ISSUER=fmr-local
FMR_JWT_TTL_MINUTES=480
FMR_SEED_DEMO_USERS=true
FMR_DEMO_PASSWORD=Password123!
FMR_EXPORT_KEY=fmr-admin-2026
GEMINI_API_KEY=AIzaSy-your-key-here
