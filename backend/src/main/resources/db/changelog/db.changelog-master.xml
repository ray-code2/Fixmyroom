<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Baseline. Reuses the existing schema.sql, which is fully idempotent
        (CREATE TABLE IF NOT EXISTS / ADD COLUMN IF NOT EXISTS), so it is safe on
        BOTH a fresh database (creates everything) and an existing database created
        by the old spring.sql.init path (every statement no-ops, data preserved).
        Liquibase records it as run once; schema.sql is never executed again.
    -->
    <changeSet id="001-baseline-schema" author="fmr">
        <comment>Baseline current schema from schema.sql (idempotent)</comment>
        <sqlFile path="schema.sql" relativeToChangelogFile="false"
                 splitStatements="true" stripComments="true"/>
        <rollback>
            <sql>
                DROP TABLE IF EXISTS issue_photos;
                DROP TABLE IF EXISTS issue_status_history;
                DROP TABLE IF EXISTS issue_notes;
                DROP TABLE IF EXISTS issues;
                DROP TABLE IF EXISTS rooms;
                DROP TABLE IF EXISTS employees;
                DROP TABLE IF EXISTS hotels;
                DROP TABLE IF EXISTS landing_leads;
            </sql>
        </rollback>
    </changeSet>

    <!--
        Tenancy rename: hotel_id -> business_id, hotels -> businesses.
        Done additively in stages so data is never lost mid-migration and the change
        is reversible. hotel_id is intentionally KEPT for the dual-claim transition
        window; dropping it is a separate later changeset, only after all clients
        have been re-issued tokens.
    -->
    <changeSet id="002-rename-hotels-to-businesses" author="fmr">
        <comment>Rename the tenant/org table hotels -> businesses</comment>
        <sql>ALTER TABLE hotels RENAME TO businesses;</sql>
        <rollback>ALTER TABLE businesses RENAME TO hotels;</rollback>
    </changeSet>

    <changeSet id="003-add-business-id-columns" author="fmr">
        <comment>Add nullable business_id alongside hotel_id (auto-rollback drops them)</comment>
        <addColumn tableName="employees">
            <column name="business_id" type="UUID"/>
        </addColumn>
        <addColumn tableName="rooms">
            <column name="business_id" type="UUID"/>
        </addColumn>
        <addColumn tableName="issues">
            <column name="business_id" type="UUID"/>
        </addColumn>
    </changeSet>

    <changeSet id="004-backfill-business-id" author="fmr">
        <comment>Backfill business_id from hotel_id; no data is dropped</comment>
        <sql>UPDATE employees SET business_id = hotel_id WHERE business_id IS NULL;</sql>
        <sql>UPDATE rooms     SET business_id = hotel_id WHERE business_id IS NULL;</sql>
        <sql>UPDATE issues    SET business_id = hotel_id WHERE business_id IS NULL;</sql>
        <rollback/> <!-- reverted by dropping the columns in 003's rollback -->
    </changeSet>

    <changeSet id="005-business-id-constraints" author="fmr">
        <comment>Make business_id NOT NULL, FK to businesses(id), and indexed</comment>
        <addNotNullConstraint tableName="employees" columnName="business_id" columnDataType="UUID"/>
        <addNotNullConstraint tableName="rooms"     columnName="business_id" columnDataType="UUID"/>
        <addNotNullConstraint tableName="issues"    columnName="business_id" columnDataType="UUID"/>

        <addForeignKeyConstraint baseTableName="employees" baseColumnNames="business_id"
                                 constraintName="fk_employees_business"
                                 referencedTableName="businesses" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="rooms" baseColumnNames="business_id"
                                 constraintName="fk_rooms_business"
                                 referencedTableName="businesses" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="issues" baseColumnNames="business_id"
                                 constraintName="fk_issues_business"
                                 referencedTableName="businesses" referencedColumnNames="id"/>

        <createIndex tableName="employees" indexName="idx_employees_business_id">
            <column name="business_id"/>
        </createIndex>
        <createIndex tableName="rooms" indexName="idx_rooms_business_id">
            <column name="business_id"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_business_id">
            <column name="business_id"/>
        </createIndex>
    </changeSet>

    <!--
        Ticket-level approval gate: adds APPROVED and DECLINED to issues.status so a
        manager must approve (or decline) a NEW ticket before it can be assigned to a
        technician. See IssueService.assign()/approve()/decline().

        The status column's CHECK constraint was declared inline and unnamed in
        schema.sql, so each engine auto-generates its own name for it:
          - H2 gives it an opaque CONSTRAINT_<hex> name that is NOT stable across
            databases. An earlier version of this changeset hardcoded that name and
            it broke repeatedly: the file-backed dev DB, a freshly rebuilt dev DB and
            the in-memory test DB each produced a different one (CONSTRAINT_814A66 /
            CONSTRAINT_B9B772B / CONSTRAINT_81). Do not hardcode it. The H2 branch
            below instead looks the name up in information_schema at migration time
            and drops it via EXECUTE IMMEDIATE. It matches on the check clause
            mentioning the STATUS column (UPPER()-folded, since DATABASE_TO_LOWER
            changes the rendered case), so the sibling category/priority checks on the
            same table are left alone.
          - Real Postgres names an unnamed column CHECK constraint deterministically
            as "<table>_<column>_check" by convention, so it's "issues_status_check"
            there without needing to look anything up.
        Both engines converge on the same explicit name afterward, so no future
        changeset touching this constraint needs to repeat this dance.

        validCheckSum=ANY: this changeset's SQL was corrected after it had already been
        applied to existing databases. The end state it produces is unchanged, so the
        old recorded checksums are still valid.
    -->
    <changeSet id="006-issue-approval-gate" author="fmr">
        <validCheckSum>ANY</validCheckSum>
        <comment>Widen issues.status CHECK to add APPROVED and DECLINED</comment>
        <sql dbms="h2">
            EXECUTE IMMEDIATE (
                SELECT 'ALTER TABLE issues DROP CONSTRAINT "' || cc.constraint_name || '"'
                FROM information_schema.check_constraints cc
                JOIN information_schema.table_constraints tc
                  ON tc.constraint_name = cc.constraint_name
                WHERE UPPER(tc.table_name) = 'ISSUES'
                  AND UPPER(cc.check_clause) LIKE '%"STATUS"%'
            );
        </sql>
        <sql dbms="postgresql">ALTER TABLE issues DROP CONSTRAINT issues_status_check;</sql>
        <sql>
            ALTER TABLE issues ADD CONSTRAINT issues_status_check
                CHECK (status IN ('NEW','APPROVED','DECLINED','ASSIGNED','IN_PROGRESS','WAITING_PARTS','COMPLETED','CANCELLED'));
        </sql>
        <rollback>
            <sql>ALTER TABLE issues DROP CONSTRAINT issues_status_check;</sql>
            <sql>
                ALTER TABLE issues ADD CONSTRAINT issues_status_check
                    CHECK (status IN ('NEW','ASSIGNED','IN_PROGRESS','WAITING_PARTS','COMPLETED','CANCELLED'));
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="007-issue-query-indexes" author="fmr">
        <comment>Composite indexes for the hot issue queries: tenant lists ordered by created_at,
            per-reporter counts (staff dashboard / mine=true), and per-status counters.
            The single-column business_id index from 005 stays for FK enforcement.</comment>
        <createIndex tableName="issues" indexName="idx_issues_business_created">
            <column name="business_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_business_reported">
            <column name="business_id"/>
            <column name="reported_by"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_business_status">
            <column name="business_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="008-employee-notes-specialties" author="fmr">
        <comment>Optional free-text notes per employee, plus technician specialties stored
            as a comma-separated list of IssueCategory names (e.g. "PLUMBING,ELECTRICAL")
            so managers can match technicians to an issue's category when assigning.</comment>
        <addColumn tableName="employees">
            <column name="notes" type="VARCHAR(500)"/>
            <column name="specialties" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!--
        Completes the tenancy rename started in 002-005 by dropping the legacy hotel_id
        columns. business_id has been NOT NULL, FK-constrained, and backfilled from
        hotel_id since 005, and no code reads hotel_id any more — the dual-write in the
        employees/rooms/issues INSERTs was removed alongside this changeset.

        Scope note: this drops the hotel_id COLUMNS only. The legacy hotel_id/hotel_name
        JWT *claims* (emitted in AuthService, read as a fallback in JwtTenant) are a
        separate concern about tokens issued before the rename, and are deliberately
        left in place — see the JwtTenant warning in CLAUDE.md. Dropping these columns
        does not depend on them.

        uq_rooms_hotel_number is dropped EXPLICITLY first, because the two engines
        disagree about what an implicit drop should do: Postgres silently cascades and
        removes the dependent unique constraint (so rooms quietly lose their
        no-duplicate-room-number guarantee), while H2 refuses the column drop outright
        with "Column may be referenced by UQ_ROOMS_HOTEL_NUMBER". Dropping it by name
        makes the intent explicit and behaves the same on both. Changeset 010
        immediately re-establishes the same guarantee keyed on business_id — the two
        belong together and neither should be applied without the other.

        Indexes (idx_*_hotel_id) and the hotels(id) FKs are dependent on the column and
        go away with it on both engines.

        validCheckSum=ANY: the explicit dropUniqueConstraint was added after this
        changeset had already been applied to the dev Postgres database. The end state
        is unchanged, so the old recorded checksum is still valid.
    -->
    <changeSet id="009-drop-legacy-hotel-id" author="fmr">
        <validCheckSum>ANY</validCheckSum>
        <comment>Drop legacy hotel_id columns; business_id is now the sole tenant key</comment>
        <dropUniqueConstraint tableName="rooms" constraintName="uq_rooms_hotel_number"/>
        <dropColumn tableName="employees" columnName="hotel_id"/>
        <dropColumn tableName="rooms"     columnName="hotel_id"/>
        <dropColumn tableName="issues"    columnName="hotel_id"/>
        <rollback>
            <addColumn tableName="employees">
                <column name="hotel_id" type="UUID"/>
            </addColumn>
            <addColumn tableName="rooms">
                <column name="hotel_id" type="UUID"/>
            </addColumn>
            <addColumn tableName="issues">
                <column name="hotel_id" type="UUID"/>
            </addColumn>
            <sql>UPDATE employees SET hotel_id = business_id;</sql>
            <sql>UPDATE rooms     SET hotel_id = business_id;</sql>
            <sql>UPDATE issues    SET hotel_id = business_id;</sql>
        </rollback>
    </changeSet>

    <!--
        Restores the room-number uniqueness that 009 destroyed as a side effect.

        schema.sql declared it as CONSTRAINT uq_rooms_hotel_number UNIQUE (hotel_id,
        room_number). Dropping the hotel_id column in 009 also dropped that constraint —
        Postgres removes any constraint that depends on a dropped column, without warning —
        which briefly left rooms with no uniqueness at all beyond the surrogate PK, so the
        same room number could be created twice within one business.

        This re-establishes the same guarantee keyed on business_id, which is what the
        constraint should have been keyed on since the 002-005 rename anyway.
    -->
    <changeSet id="010-restore-room-number-uniqueness" author="fmr">
        <comment>Re-add UNIQUE (business_id, room_number) lost when hotel_id was dropped</comment>
        <addUniqueConstraint tableName="rooms"
                             columnNames="business_id, room_number"
                             constraintName="uq_rooms_business_number"/>
        <rollback>
            <dropUniqueConstraint tableName="rooms" constraintName="uq_rooms_business_number"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
